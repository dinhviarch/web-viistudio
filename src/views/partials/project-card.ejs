<article class="project-card reveal" data-category="<%= project.category %>">
  <a href="<%= url(project.url) %>" class="project-card-link">
    <div class="project-card-media">
      <img src="<%= url(project.cover) %>" alt="<%= project.title %> — <%= project.location %>" loading="lazy" width="1200" height="900">
    </div>
    <div class="project-card-body">
      <h3 class="project-card-title"><%= project.title %></h3>
      <p class="project-card-meta"><%= catLabel(project.category) %> · <%= project.location %> · <%= project.year %></p>
    </div>
  </a>
</article>
